---
import { site, whatsappLink } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="bg-ink-950 text-paper-200/75 pb-10 pt-16">
  <div class="container-x">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-paper-50/5 text-gold-400 font-serif ring-1 ring-paper-50/10">JS</span>
          <div>
            <p class="font-serif text-lg text-paper-50">Jeimy Silva · Contadora Pública</p>
            <p class="text-[11px] uppercase tracking-[0.22em] text-gold-400">T.P. 264278-T · JCC</p>
          </div>
        </div>
        <p class="mt-5 max-w-sm text-sm text-paper-200/70">
          Rigor, confidencialidad y resultados medibles. Más de una década protegiendo
          el patrimonio de empresas, personas de alto patrimonio e independientes.
        </p>
      </div>

      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold-400">Secciones</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="#servicios" class="hover:text-paper-50">Servicios</a></li>
          <li><a href="#sobre-jeimy" class="hover:text-paper-50">Sobre Jeimy</a></li>
          <li><a href="#para-quien" class="hover:text-paper-50">Para quién</a></li>
          <li><a href="#clientes" class="hover:text-paper-50">Clientes y testimonios</a></li>
          <li><a href="#contacto" class="hover:text-paper-50">Contacto</a></li>
        </ul>
      </div>

      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-gold-400">Contacto</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href={whatsappLink()} target="_blank" rel="noopener" class="hover:text-paper-50">WhatsApp {site.phoneDisplay}</a></li>
          <li><a href={`mailto:${site.email}`} class="hover:text-paper-50 break-all">{site.email}</a></li>
          <li>Boyacá · Casanare · Cundinamarca</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-paper-50/10 pt-6 text-xs text-paper-200/60 md:flex-row md:items-center">
      <p>© {year} Jeimy Marisela Silva Molano · Todos los derechos reservados.</p>
      <p class="flex items-center gap-2">
        <span class="inline-block h-1 w-1 rounded-full bg-gold-500"></span>
        Desarrollado por
        <a
          href="https://strategaconsultoria.com"
          target="_blank"
          rel="noopener"
          class="font-medium text-paper-100 transition-colors hover:text-gold-400"
        >
          Strategia Consultoría e Innovación
        </a>
      </p>
    </div>
  </div>
</footer>

<!-- Botón flotante WhatsApp -->
<a
  href={whatsappLink()}
  target="_blank"
  rel="noopener"
  aria-label="Escribir por WhatsApp"
  class="fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-soft transition-transform hover:scale-105 focus-visible:ring-2 focus-visible:ring-gold-500 focus-visible:ring-offset-2"
>
  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#25D366] opacity-30"></span>
  <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 24 24"><path d="M20.52 3.48A11.9 11.9 0 0 0 12.04 0C5.46 0 .09 5.37.09 11.96c0 2.11.55 4.17 1.6 5.98L0 24l6.21-1.63a11.9 11.9 0 0 0 5.83 1.49h.01c6.58 0 11.95-5.37 11.95-11.96 0-3.19-1.24-6.19-3.48-8.42zM12.04 21.8h-.01a9.84 9.84 0 0 1-5.02-1.38l-.36-.21-3.68.97.98-3.59-.23-.37a9.85 9.85 0 0 1-1.51-5.26c0-5.44 4.43-9.87 9.87-9.87 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.98c0 5.44-4.43 9.83-9.92 9.83z"/></svg>
</a>

---
import { site, whatsappLink } from '../lib/site';
const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#sobre-jeimy', label: 'Sobre Jeimy' },
  { href: '#para-quien', label: 'Para quién' },
  { href: '#clientes', label: 'Clientes' },
  { href: '#contacto', label: 'Contacto' },
];
---
<nav
  id="site-nav"
  class="fixed inset-x-0 top-0 z-40 transition-all duration-500"
  aria-label="Navegación principal"
>
  <div class="container-x">
    <div class="mt-4 flex items-center justify-between rounded-full border border-ink-900/5 bg-white/70 px-5 py-3 backdrop-blur-xl shadow-soft transition-all duration-500 [#site-nav.is-scrolled_&]:mt-2 [#site-nav.is-scrolled_&]:bg-white/90">
      <a href="#top" class="flex items-center gap-3 group">
        <span class="relative inline-flex h-9 w-9 items-center justify-center rounded-full bg-ink-950 text-gold-400 font-serif text-base font-semibold">
          JS
          <span class="absolute inset-0 rounded-full ring-1 ring-gold-500/40"></span>
        </span>
        <span class="hidden sm:flex flex-col leading-tight">
          <span class="font-serif text-base text-ink-950">Jeimy Silva</span>
          <span class="text-[10px] uppercase tracking-[0.22em] text-gold-600">Contadora Pública</span>
        </span>
      </a>

      <ul class="hidden lg:flex items-center gap-8">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="text-sm font-medium text-ink-800 transition-colors hover:text-gold-600"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <a
          href={whatsappLink()}
          target="_blank"
          rel="noopener"
          class="btn-gold hidden md:inline-flex"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M20.52 3.48A11.9 11.9 0 0 0 12.04 0C5.46 0 .09 5.37.09 11.96c0 2.11.55 4.17 1.6 5.98L0 24l6.21-1.63a11.9 11.9 0 0 0 5.83 1.49h.01c6.58 0 11.95-5.37 11.95-11.96 0-3.19-1.24-6.19-3.48-8.42zM12.04 21.8h-.01a9.84 9.84 0 0 1-5.02-1.38l-.36-.21-3.68.97.98-3.59-.23-.37a9.85 9.85 0 0 1-1.51-5.26c0-5.44 4.43-9.87 9.87-9.87 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.98c0 5.44-4.43 9.83-9.92 9.83zm5.42-7.37c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.37-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.07 2.9 1.22 3.1c.15.2 2.1 3.2 5.08 4.48.71.3 1.27.48 1.7.62.71.22 1.36.19 1.88.12.57-.09 1.76-.72 2.01-1.42.25-.69.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35z"/></svg>
          WhatsApp
        </a>
        <button
          id="menu-btn"
          type="button"
          class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-full border border-ink-900/10"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden mt-2 rounded-2xl border border-ink-900/10 bg-white/95 p-4 backdrop-blur-xl shadow-soft">
      <ul class="flex flex-col gap-1">
        {links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-lg px-4 py-3 text-sm font-medium text-ink-800 hover:bg-paper-100">
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-gold mt-2 w-full">
            Escribir por WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

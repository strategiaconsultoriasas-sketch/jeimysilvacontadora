---
import { site, whatsappLink } from '../lib/site';
---
<section id="top" class="relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28 lg:pb-32">
  <!-- fondos decorativos -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-paper-50 via-paper-50 to-white"></div>
    <div class="absolute -top-40 right-[-10%] h-[520px] w-[520px] rounded-full bg-gold-300/25 blur-3xl"></div>
    <div class="absolute top-40 left-[-10%] h-[420px] w-[420px] rounded-full bg-ink-900/5 blur-3xl"></div>
    <div class="absolute inset-0 bg-grain opacity-40 mix-blend-multiply"></div>
  </div>

  <div class="container-x">
    <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
      <!-- Columna texto -->
      <div class="relative">
        <span class="eyebrow animate-fade-in">Contadora Pública · T.P. 264278-T JCC</span>
        <h1 class="mt-6 h-display text-ink-950 animate-fade-up">
          Control contable,
          <span class="italic text-gold-600">estrategia</span>
          y claridad para
          <span class="relative inline-block">
            decidir mejor.
            <svg aria-hidden="true" class="absolute left-0 -bottom-2 w-full" viewBox="0 0 300 10" fill="none">
              <path d="M2 7 C 80 1, 220 1, 298 7" stroke="#B08D57" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-800/85 animate-fade-up" style="animation-delay:120ms">
          Soy <strong class="font-semibold text-ink-900">Jeimy Marisela Silva Molano</strong>.
          Protejo el patrimonio de empresas y personas con revisoría fiscal, auditoría forense
          y una visión gerencial que convierte la contabilidad en decisiones.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3 animate-fade-up" style="animation-delay:200ms">
          <a href={whatsappLink()} target="_blank" rel="noopener" class="btn-gold">
            Agendar asesoría
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="#servicios" class="btn-ghost">Ver servicios</a>
        </div>

        <!-- Prueba social compacta -->
        <dl class="mt-12 grid grid-cols-3 gap-6 max-w-md animate-fade-up" style="animation-delay:280ms">
          <div>
            <dt class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold-600">Experiencia</dt>
            <dd class="mt-1 font-serif text-3xl text-ink-950">+10<span class="text-gold-500">·</span></dd>
            <dd class="text-xs text-ink-800/70">años ejerciendo</dd>
          </div>
          <div>
            <dt class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold-600">Tarjeta</dt>
            <dd class="mt-1 font-serif text-3xl text-ink-950">264278<span class="text-gold-500">-T</span></dd>
            <dd class="text-xs text-ink-800/70">JCC vigente</dd>
          </div>
          <div>
            <dt class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold-600">Cobertura</dt>
            <dd class="mt-1 font-serif text-lg text-ink-950 leading-tight">Boyacá · Casanare · Cundinamarca</dd>
          </div>
        </dl>
      </div>

      <!-- Columna foto -->
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="relative aspect-[4/5] lg:aspect-[5/6] overflow-hidden rounded-[2rem] bg-ink-900 shadow-soft">
          <img
            src="/images/jeimy-office-wide.webp"
            alt="Jeimy Silva, Contadora Pública · retrato editorial"
            width="1456"
            height="965"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover object-[52%_32%] scale-110"
          />
          <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink-950/70 to-transparent"></div>
          <div class="absolute left-5 bottom-5 right-5 flex items-center justify-between text-paper-50">
            <div>
              <p class="font-serif text-xl leading-tight">Jeimy Silva</p>
              <p class="text-[11px] uppercase tracking-[0.22em] text-gold-300">Revisoría · Forense · CFO</p>
            </div>
            <span class="inline-flex items-center gap-2 rounded-full bg-paper-50/10 px-3 py-1.5 text-[11px] uppercase tracking-widest ring-1 ring-paper-50/20 backdrop-blur">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400 animate-shimmer"></span>
              Atendiendo
            </span>
          </div>
        </div>

        <!-- tarjeta flotante -->
        <div class="absolute -left-4 bottom-10 hidden sm:block rounded-2xl border border-ink-900/10 bg-white/95 p-5 shadow-soft backdrop-blur-xl md:-left-10 lg:-left-14">
          <p class="eyebrow">Especialidades</p>
          <ul class="mt-3 space-y-1.5 text-sm text-ink-900">
            <li class="flex items-center gap-2"><span class="h-1 w-1 rounded-full bg-gold-500"></span>Revisoría Fiscal</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 rounded-full bg-gold-500"></span>Auditoría Forense</li>
            <li class="flex items-center gap-2"><span class="h-1 w-1 rounded-full bg-gold-500"></span>Gerencia Financiera</li>
          </ul>
        </div>

        <!-- adorno dorado -->
        <div class="pointer-events-none absolute -right-4 -top-4 hidden h-24 w-24 rounded-full border-2 border-gold-500 md:block"></div>
      </div>
    </div>
  </div>

  <!-- barra de pilares -->
  <div class="container-x mt-20 md:mt-28">
    <ul class="grid grid-cols-2 gap-6 border-t border-ink-900/10 pt-8 text-sm md:grid-cols-4">
      {[
        ['Rigor', 'Técnica NIIF y tributaria sin atajos.'],
        ['Confidencialidad', 'Secreto profesional como regla.'],
        ['Resultados medibles', 'Indicadores y KPIs claros.'],
        ['Cumplimiento', '100% dentro del marco legal.'],
      ].map(([title, body]) => (
        <li class="reveal flex flex-col">
          <span class="font-serif text-xl text-ink-950">{title}</span>
          <span class="mt-1 text-ink-800/75">{body}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
